JWT_SECRET=

# Middleware service ERP session.
# Required for feature-authorized write workflows, e.g. order creation,
# vendor PDF parsing, item updates, payments, and attachments.
# Do not hardcode this in docker-compose; set it in .env.mw on each server.
ERP_SETUP_FULL_NAME=Administrator
ERP_SETUP_PASSWORD=

APP_INVOICE_TEMPLATE_GENERATOR_TYPE=external_api
APP_INVOICE_TEMPLATE_GENERATOR_BASE_URL=https://openrouter.ai/api/v1
APP_INVOICE_TEMPLATE_GENERATOR_MODEL=anthropic/claude-3.5-sonnet
APP_INVOICE_TEMPLATE_GENERATOR_API_KEY=
APP_INVOICE_TEMPLATE_GENERATOR_API_VERSION=2023-06-01
APP_INVOICE_TEMPLATE_GENERATOR_DEBUG_ENABLED=true
APP_INVOICE_TEMPLATE_GENERATOR_FEIGN_LOG_LEVEL=FULL
APP_INVOICE_TEMPLATE_GENERATOR_OPENROUTER_SITE_URL=http://localhost:4200
APP_INVOICE_TEMPLATE_GENERATOR_OPENROUTER_TITLE=AAS Ops Console

# Meta WhatsApp Cloud API
APP_INVOICE_DELIVERY_WHATSAPP_META_ACCESS_TOKEN=
APP_INVOICE_DELIVERY_WHATSAPP_META_PHONE_NUMBER_ID=
APP_INVOICE_DELIVERY_WHATSAPP_META_GRAPH_API_VERSION=v25.0
